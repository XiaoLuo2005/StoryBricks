  stylePromptPrefix: "\u513F\u7AE5\u7ED8\u672C\u6C34\u5F69\u63D2\u753B\uFF0C\u6E29\u6696\u660E\u4EAE\u8272\u8C03\uFF0C\u6A2A\u724816\u6BD49\u3002\u8FDC\u666F\u6216\u4E2D\u8FDC\u666F\u6784\u56FE\uFF0C\u89D2\u8272\u6574\u4F53\u9AD8\u5EA6\u4E0D\u8D85\u8FC7\u753B\u9762\u9AD8\u5EA6\u768435%\uFF0C\u89D2\u8272\u4E0D\u8981\u7279\u5199\u3001\u4E0D\u8981\u5927\u5934\u7167\uFF0C\u7559\u51FA\u5927\u9762\u79EF\u5929\u7A7A\u8349\u5730\u548C\u8D5B\u9053\u80CC\u666F\uFF0C\u73AF\u5883\u80CC\u666F\u6E05\u6670\u53EF\u8FA8\uFF0C\u89D2\u8272\u5728\u753B\u9762\u4E2D\u504F\u4E2D\u4E0B\u3001\u5360\u6BD4\u8F83\u5C0F"
  creationPages:
  - pageId: p1_start
    pageTitle: "\u8D77\u8DD1\u7EBF"
    backgroundSprite: {fileID: 21300000, guid: ce5ec7d06fe734747bd0d1ddbfdbc041, type: 3}
    sceneGuideText: "\u9F9F\u5154\u7AD9\u5728\u8D77\u8DD1\u7EBF\u65C1\uFF0C\u51C6\u5907\u597D\u4E86\u5417\uFF1F\u628A\u5B83\u4EEC\u6446\u6210\u51C6\u5907\u5F00\u8DD1\u7684\u6837\u5B50\u5427\uFF01"
    voiceGuideText: "\u5C0F\u9F9F\u548C\u5C0F\u5154\u8981\u6BD4\u8D5B\u5566\uFF01\u8BF7\u628A\u9F9F\u5154\u653E\u5728\u8D77\u8DD1\u7EBF\u65C1\u8FB9\uFF0C\u6446\u597D\u51C6\u5907\u5F00\u8DD1\u7684\u6837\u5B50\u3002"
    requiredCharacterIds: 0100000002000000
    optionalElementQuestion: "\u5C0F\u670B\u53CB\uFF0C\u8D77\u8DD1\u7EBF\u8FD9\u4E00\u9875\u8FD8\u60F3\u52A0\u70B9\u4EC0\u4E48\u5417\uFF1F\u6BD4\u5982\u65D7\u5E1C\u3001\u9C9C\u82B1\uFF0C\u5FEB\u6765\u544A\u8BC9\u8001\u5E08\u5427\uFF01"
  - pageId: p2_tree
    pageTitle: "\u5927\u6811\u4F11\u606F"
    backgroundSprite: {fileID: 21300000, guid: c11ac6f1c22ab174ca79704ee204a6e9, type: 3}
    sceneGuideText: "\u6BD4\u8D5B\u5F00\u59CB\u5566\uFF01\u5154\u5B50\u8DD1\u5230\u4E86\u5927\u6811\u4E0B\uFF0C\u4E4C\u9F9F\u8FD8\u5728\u540E\u9762\u6162\u6162\u722C\u3002\u60F3\u60F3\u5B83\u4EEC\u5728\u8FD9\u91CC\u4F1A\u505A\u4EC0\u4E48\uFF1F"
    voiceGuideText: "\u5154\u5B50\u8DD1\u5230\u5927\u6811\u4E0B\u5566\uFF01\u6446\u4E00\u6446\u79EF\u6728\uFF0C\u8BB2\u8BB2\u5154\u5B50\u548C\u4E4C\u9F9F\u73B0\u5728\u60F3\u505A\u4EC0\u4E48\u5427\u3002"
    requiredCharacterIds: 01000000
    optionalElementQuestion: "\u5C0F\u670B\u53CB\uFF0C\u5927\u6811\u4F11\u606F\u8FD9\u4E00\u9875\u8FD8\u60F3\u52A0\u4EC0\u4E48\u5462\uFF1F\u6BD4\u5982\u5927\u6811\u3001\u5C0F\u82B1\uFF0C\u5FEB\u6765\u544A\u8BC9\u8001\u5E08\u5427\uFF01"
  - pageId: p3_finish
    pageTitle: "\u51B2\u8FC7\u7EC8\u70B9"
    backgroundSprite: {fileID: 21300000, guid: 2510e8f3e00224140b5b1c1987868d50, type: 3}
    sceneGuideText: "\u5FEB\u5230\u7EC8\u70B9\u4E86\uFF01\u6446\u597D\u5154\u5B50\u548C\u4E4C\u9F9F\uFF0C\u770B\u770B\u8C01\u5148\u51B2\u8FC7\u7EC8\u70B9\u7EBF\uFF01"
    voiceGuideText: "\u9A6C\u4E0A\u8981\u5230\u7EC8\u70B9\u5566\uFF01\u6446\u597D\u9F9F\u5154\uFF0C\u770B\u770B\u8C01\u5148\u5230\u8FBE\u7EC8\u70B9\u7EBF\uFF01"
    requiredCharacterIds: 0100000002000000
    optionalElementQuestion: "\u5C0F\u670B\u53CB\uFF0C\u5FEB\u5230\u7EC8\u70B9\u5566\uFF0C\u8FD9\u4E00\u9875\u8FD8\u60F3\u52A0\u70B9\u4EC0\u4E48\u5417\uFF1F\u6BD4\u5982\u7EC8\u70B9\u7EBF\u3001\u5956\u676F\uFF0C\u5FEB\u6765\u544A\u8BC9\u8001\u5E08\u5427\uFF01"
  creationSceneName: StoryCreation
