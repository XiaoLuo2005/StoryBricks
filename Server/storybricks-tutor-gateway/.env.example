# StoryBricks 语音网关 — 复制为 .env 并填写卡密
# cp .env.example .env

# ========== DeepSeek（故事创作：AI 提问 + 回答语义整理）==========
# 在 https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=在这里填写你的DeepSeek卡密
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ========== 可选：阿里云灵积（教程助教 / 备用 TTS·ASR）==========
# DASHSCOPE_API_KEY=

# TTS：edge=免费 Edge 语音（默认无 Dash 时）；dash=CosyVoice
TTS_PROVIDER=edge

# ASR：auto=有 Dash 用 Dash 否则本机 Whisper；local=仅本机 Whisper；dash=仅 Dash
ASR_PROVIDER=auto

# Edge 中文女声（免费 TTS，无需卡密）
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

PORT=8787
